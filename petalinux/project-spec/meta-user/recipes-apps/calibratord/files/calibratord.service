[Unit]
Description=RFSoC calibrator service
After=systemd-modules-load.service network-online.target dev-calibrator\x2devents.device
Wants=network-online.target
Requires=dev-calibrator\x2devents.device

[Service]
Type=simple
EnvironmentFile=-/etc/default/calibratord
ExecStart=/usr/sbin/calibratord
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
ReadWritePaths=/dev /run

[Install]
WantedBy=multi-user.target
